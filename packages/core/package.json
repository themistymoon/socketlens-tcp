{
  "name": "@socketlens/core",
  "version": "0.1.1",
  "private": true,
  "description": "Shared SocketLens TCP domain logic: sessions, mock rules, test scenarios, assertions, the SLTP client, and protocol logging.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./models": {
      "types": "./dist/models.d.ts",
      "default": "./dist/models.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
  },
  "dependencies": {
    "@socketlens/protocol": "0.1.0"
  }
}
