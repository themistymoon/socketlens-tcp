{
  "name": "socketlens-tcp",
  "version": "0.1.0",
  "private": true,
  "description": "A local developer tool for designing, mocking, testing, and debugging custom application-layer protocols over raw TCP streams.",
  "license": "MIT",
  "author": "Natthakit Jantawong",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/themistymoon/socketlens-tcp.git"
  },
  "bugs": {
    "url": "https://github.com/themistymoon/socketlens-tcp/issues"
  },
  "homepage": "https://github.com/themistymoon/socketlens-tcp#readme",
  "keywords": [
    "tcp",
    "socket",
    "protocol",
    "protocol-design",
    "message-framing",
    "mock-server",
    "network-debugging",
    "sltp"
  ],
  "type": "module",
  "engines": {
    "node": ">=20.11.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "build": "npm run build:ts && npm run build:gui",
    "build:ts": "tsc -b tsconfig.json",
    "build:gui": "npm run build --workspace @socketlens/gui",
    "clean": "node scripts/clean.mjs",
    "start:server": "node apps/server/dist/index.js",
    "start:gui": "node apps/bridge/dist/index.js --static apps/gui/dist --open",
    "cli": "node apps/cli/dist/index.js",
    "dev": "node scripts/dev-gui.mjs --with-server",
    "dev:server": "npm run build:ts && tsx watch apps/server/src/index.ts",
    "dev:cli": "npm run build:ts && tsx apps/cli/src/index.ts",
    "dev:bridge": "npm run build:ts && tsx apps/bridge/src/index.ts",
    "dev:gui": "node scripts/dev-gui.mjs",
    "examples": "npm run build:ts && tsx examples/run-all.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b tsconfig.json && npm run typecheck:tests",
    "verify": "npm run format:check && npm run lint && npm run typecheck && npm run test && npm run build",
    "typecheck:tests": "tsc -p tsconfig.tests.json"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/node": "^20.14.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "globals": "^15.0.0",
    "jsdom": "^26.0.0",
    "prettier": "^3.3.0",
    "tsx": "^4.16.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
