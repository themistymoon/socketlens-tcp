{
  "format": "socketlens-scenario-bundle/1",
  "protocol": "SLTP/1.0",
  "name": "Basic PING",
  "description": "The smallest complete SLTP exchange: one request, one response, one TCP write each way.",
  "rules": [
    {
      "id": "ping-ok",
      "name": "Answer PING with pong",
      "priority": 10,
      "match": { "operation": "PING" },
      "response": {
        "statusCode": 200,
        "statusPhrase": "OK",
        "headers": { "Content-Type": "application/json; charset=utf-8" },
        "body": "{\"message\":\"pong\"}"
      }
    }
  ],
  "scenarios": [
    {
      "name": "basic-ping",
      "description": "Sends one PING in a single TCP write and expects 200 OK.",
      "request": { "operation": "PING" },
      "transmission": { "mode": "single" },
      "timeoutMs": 2000,
      "expect": {
        "statusCode": 200,
        "statusPhrase": "OK",
        "jsonSubset": { "message": "pong" }
      }
    }
  ]
}
